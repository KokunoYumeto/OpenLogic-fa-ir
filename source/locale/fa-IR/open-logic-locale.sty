  {\textit{#1}،
  اثر #2،
  با #3 منتشر شده است.}
\renewcommand*{\olshortlicensetext}[1]
  {\textit{\href{\OLTlinkname}{\olFaLTR{\jobname}}}
  \ifgitinfo\space
  اثر #1 /
  \href{http://creativecommons.org/licenses/by/4.0/}{\olFaLTR{CC--BY}}.}
\renewcommand*{\oluselicensetext}
  {این اثر بر پایهٔ
  \textit{\href{\OLTlinkname}{\OLTname}}
  از
  \href{http://openlogicproject.org/}{\OLPname}
  تهیه شده است؛ اثر یادشده با
  \href{http://creativecommons.org/licenses/by/4.0/}{\licensename}
  به‌کار رفته است.}
\renewcommand*{\olshortuselicensetext}[2]
  {\textit{#1}، اثر #2، بر پایهٔ
  \href{http://openlogicproject.org/}{\olFaLTR{OLP}} /
  \href{http://creativecommons.org/licenses/by/4.0/}{\olFaLTR{CC--BY}}.}

